---
// Selector de idioma en la cabecera (arriba a la derecha). Sustituye al widget flotante de TranslatePress.
import { LANGS, LANG_NAME, FLAG } from '../lib/data.mjs';
const { doc } = Astro.props;
const alts = doc.alternates || {};
const cur = doc.lang;
const others = LANGS.filter((l) => l !== cur);
const home = (l) => (l === 'es' ? '/' : `/${l}/`);
---
<div class="k-element k-widget__width-auto ls-widget">
  <nav class="ls" aria-label={LANG_NAME[cur]}>
    <button type="button" class="ls__cur" aria-haspopup="listbox" aria-expanded="false" aria-controls="ls-list" title={LANG_NAME[cur]}>
      <img src={`/flags/${FLAG[cur]}.svg`} alt="" width="20" height="15" /><span class="ls__code">{cur.toUpperCase()}</span><span class="ls__chev" aria-hidden="true"></span>
    </button>
    <ul class="ls__list" id="ls-list" role="listbox" hidden>
      {others.map((l) => (
        <li role="option"><a href={alts[l] || home(l)} hreflang={l} lang={l}><img src={`/flags/${FLAG[l]}.svg`} alt="" width="20" height="15" loading="lazy" /><span>{LANG_NAME[l]}</span></a></li>
      ))}
    </ul>
  </nav>
</div>
