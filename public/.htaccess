# Generado por build_redirects.py · no editar a mano, edita url-map.csv / gone.txt
# Producción Plesk (nginx como proxy + Apache) — ver references/plesk-produccion.md

RewriteEngine On

# 1) Forzar https y el host canónico (con/sin www) en un único salto, sin cadenas
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.clinicabelba\.com$ [NC]
RewriteRule ^ https://clinicabelba.com%{REQUEST_URI} [L,R=301]

# 2) Bloqueo de rutas de administración de WordPress (ya no existen en esta web)
RewriteRule ^wp-admin(/.*)?$ - [G,L]
RewriteRule ^wp-login\.php$ - [G,L]
RewriteRule ^xmlrpc\.php$ - [G,L]

# 3) Parámetros clásicos de WordPress
# ?p=ID / ?page_id=ID -> URL real del post/página (por wp_id, ver extract_wp.py).
# Resuelto sin cadenas: si el post es 410 o su URL redirige a otra parte, la regla
# de query lo refleja directamente (nunca a un destino que a su vez es 410/301).
# QSD descarta la query completa: si el enlace llevaba también UTM, se pierde aquí;
# es la contrapartida aceptada por conservar una URL de destino limpia.
RewriteCond %{QUERY_STRING} (^|&)(p|page_id)=9(&|$)
RewriteRule ^ /quienes-somos/ [R=301,L,QSD]
RewriteCond %{QUERY_STRING} (^|&)(p|page_id)=13(&|$)
RewriteRule ^ /cirugia-de-la-mama/ [R=301,L,QSD]
